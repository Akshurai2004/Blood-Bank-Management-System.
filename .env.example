# PostgreSQL Server Configuration
DATABASE_URL=postgresql://bloodbank_app:bloodbank_dev_password@localhost:5432/bloodbank
DB_HOST=localhost
DB_PORT=5432
DB_USER=bloodbank_app
DB_PASSWORD=bloodbank_dev_password
DB_NAME=bloodbank
DB_SSL=false

# Initialize the schema and demo data at startup.
AUTO_INIT_DB=true

# Backend server and security
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
PORT=8000
JWT_SECRET_KEY=change-this-development-secret
CORS_ORIGINS=http://localhost:3000

# Redis is optional; the application falls back to an in-memory queue.
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REQUIRE_REAL_EMAIL=false

# Preferred production email transport (Resend HTTPS API).
# The sender must be verified in your Resend account.
RESEND_API_KEY=
EMAIL_FROM=Blood Bank Management <onboarding@resend.dev>

# Optional local SMTP fallback when RESEND_API_KEY is not set.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_TLS=true
